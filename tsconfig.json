{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "ES2020",
    "types": ["node"],
    "typeRoots": [
      "./node_modules/@types",
      "./generated/prisma"  // Add your custom output path
    ],
    // For nodejs:
    "lib": ["ES2020"],
    // "types": ["node"],
    // and npm install -D @types/node

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

   "strict": true,
    "esModuleInterop": true,  // IMPORTANT: Add this
    "allowSyntheticDefaultImports": true,  // IMPORTANT: Add this
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
